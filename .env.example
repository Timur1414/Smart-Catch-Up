# Config
CONFIG_PATH="/path/to/config.yaml"

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=name
POSTGRES_USER=user
POSTGRES_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# Services postgres credentials
AGGREGATOR_SERVICE_USER_LOGIN="login"
AGGREGATOR_SERVICE_USER_PASSWORD="password"
API_SERVICE_USER_LOGIN="login"
API_SERVICE_USER_PASSWORD="password"
AUTH_SERVICE_USER_LOGIN="login"
AUTH_SERVICE_USER_PASSWORD="password"
GENERATOR_SERVICE_USER_LOGIN="login"
GENERATOR_SERVICE_USER_PASSWORD="password"

# Default users
SYSTEM_USER_PASSWORD=password
ADMIN_USER_PASSWORD=password
TEST_USER_PASSWORD=password
TEST2_USER_PASSWORD=password

# Secrets
JWT_SECRET="myawesomesecret"
JWT_VERSION=0
CSRF_SECRET="myawesomesecret"
ENCRYPTOR_KEY="12345678901234567890123456789012" # 32 байта

# TOTP
TOTP_ISSUER="text"

# Grafana
GF_USER=admin
GF_PASSWORD=admin
GF_URL=http://localhost:3000

# Open router
OPENROUTER_API_KEY="key"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Docker для watch tower
DOCKERHUB_USERNAME="username"
DOCKERHUB_PASSWORD="password"

# Socks5 для сторонних LLM
PROXY_HOST="host:port"
PROXY_LOGIN="login"
PROXY_PASSWORD="password"
