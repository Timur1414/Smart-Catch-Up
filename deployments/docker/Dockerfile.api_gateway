FROM golang:1.26-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git ca-certificates tzdata
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/api_gateway ./cmd/api_gateway

FROM alpine:3.21
RUN apk --no-cache add ca-certificates tzdata curl
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
RUN mkdir -p /app/log && chown -R appuser:appgroup /app
COPY --from=builder /app/bin/api_gateway /app/api_gateway
USER appuser
EXPOSE 8080
CMD ["/app/api_gateway"]
