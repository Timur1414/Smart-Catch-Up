FROM golang:1.26-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git ca-certificates tzdata
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/fileserver ./cmd/fileserver

FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata curl
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
RUN mkdir -p /app/log /app/static && chown -R appuser:appgroup /app
COPY --from=builder /app/bin/fileserver /app/fileserver
USER appuser
EXPOSE 50053
CMD ["/app/fileserver"]
